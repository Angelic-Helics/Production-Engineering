pipeline {
    agent any

    tools {
        jdk 'jdk21'
        gradle 'gradle-8'
    }

    environment {
        DOCKER_IMAGE_NAME = 'alexdatasap/prod-eng-img'
        GITHUB_REPOSITORY = 'Angelic-Helics/Production-Engineering'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh 'gradle clean build'
            }
        }

        stage('Determine Image Version') {
            steps {
                script {
                    sh 'git fetch --tags --force'

                    env.LATEST_TAG = sh(
                        script: 'git tag | sort --version-sort | tail -1',
                        returnStdout: true
                    ).trim()

                    if (!env.LATEST_TAG) {
                        env.LATEST_TAG = '1.0.0'
                    }

                    env.MAJOR_VERSION = sh(
                        script: "echo '${env.LATEST_TAG}' | cut -d . -f 1",
                        returnStdout: true
                    ).trim()
                    env.MINOR_VERSION = sh(
                        script: "echo '${env.LATEST_TAG}' | cut -d . -f 2",
                        returnStdout: true
                    ).trim()
                    env.PATCH_VERSION = sh(
                        script: "echo '${env.LATEST_TAG}' | cut -d . -f 3",
                        returnStdout: true
                    ).trim()

                    env.MAJOR_VERSION = env.MAJOR_VERSION.isInteger() ? env.MAJOR_VERSION : '1'
                    env.MINOR_VERSION = env.MINOR_VERSION.isInteger() ? env.MINOR_VERSION : '0'
                    env.PATCH_VERSION = env.PATCH_VERSION.isInteger() ? env.PATCH_VERSION : '0'
                    env.IMAGE_TAG = "${env.MAJOR_VERSION}.${env.MINOR_VERSION.toInteger() + 1}.${env.PATCH_VERSION}"
                    env.DOCKER_IMAGE = "${env.DOCKER_IMAGE_NAME}:${env.IMAGE_TAG}"

                    echo "Latest git tag: ${env.LATEST_TAG}"
                    echo "Docker image: ${env.DOCKER_IMAGE}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t "$DOCKER_IMAGE" .'
            }
        }

        stage('Login and Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker_password',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login docker.io -u "$DOCKER_USERNAME" --password-stdin
                        docker push "$DOCKER_IMAGE"
                    '''
                }
            }
        }

        stage('Tag Git Release') {
            steps {
                withCredentials([string(credentialsId: 'github_token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "jenkins@local"
                        git config user.name "Jenkins"

                        if git rev-parse "$IMAGE_TAG" >/dev/null 2>&1; then
                            echo "Git tag $IMAGE_TAG already exists."
                        else
                            git tag "$IMAGE_TAG"
                        fi

                        git push "https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "$IMAGE_TAG"
                    '''
                }
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    docker compose --profile mongo --profile prod-eng-service up -d mongo prod-eng
                '''
            }
        }

        stage('Integration Tests') {
            steps {
                sh 'TESTCONTAINERS_RYUK_DISABLED=true MONGODB_TEST_HOST=host.docker.internal gradle testIT'
            }
        }

        stage('E2E Tests') {
            steps {
                sh 'E2E_BASE_URL=http://host.docker.internal:8080 gradle testE2E'
            }
        }
    }
}
